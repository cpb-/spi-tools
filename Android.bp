genrule {
    name: "spi_tools_config_h",
    srcs: ["VERSION", "src/config.h.cmake.in"],
    out: ["config.h"],
    cmd: "sed \"s/@SPI_TOOLS_VERSION@/$$(cat $(location VERSION))/g\" " +
        "$(location src/config.h.cmake.in) > $(out)",
}

cc_defaults {
    name: "spi_tools_defaults",
    device_specific: true,
    c_std: "gnu99",
    cflags: ["-Wall", "-Wextra"],
    generated_headers: ["spi_tools_config_h"],
    srcs: ["src/spi-tools.c"],
}

cc_binary {
    name: "spi-config",
    defaults: ["spi_tools_defaults"],
    srcs: ["src/spi-config.c"],
}

cc_binary {
    name: "spi-pipe",
    defaults: ["spi_tools_defaults"],
    srcs: ["src/spi-pipe.c"],
}

phony {
    name: "spi_tools",
    required: ["spi-config", "spi-pipe"],
}
